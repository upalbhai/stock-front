FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Pass Next.js args if needed
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG NEXT_PUBLIC_DEFAULT_OUTLET
ENV NEXT_PUBLIC_DEFAULT_OUTLET=${NEXT_PUBLIC_DEFAULT_OUTLET}
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
